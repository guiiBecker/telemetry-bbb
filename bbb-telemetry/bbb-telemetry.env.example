# Copied to /etc/bigbluebutton/bbb-telemetry.env (mode 600) by install.sh. Read by the collector only.
# SigNoz Cloud region (us, us2, eu, in...) and ingestion key: Settings -> Ingestion Settings.
SIGNOZ_REGION=us
SIGNOZ_INGESTION_KEY=replace-me
# Shows up as deployment.environment on every metric and log
BBB_TELEMETRY_ENVIRONMENT=production
